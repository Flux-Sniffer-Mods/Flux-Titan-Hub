<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications (asked for on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The built-in shell switches wireless debugging on at boot (granted through it once) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Vibration, for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Restarts the screen timeout after a key press -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Internet: update checks, GIF search, online layouts and dictionaries -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reads the Clicks Power Keyboard's details over Bluetooth LE -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Apps the keyboard needs to see: launchable apps and the ones below -->
    <queries>
        <!-- Termux tasks in the quick launcher (Add a shortcut) -->
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        
        <!-- Home screen apps -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>

        <!-- Apps offering shortcuts for the home screen: Add a shortcut -->
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>

        <!-- Optional QuickLauncher backend: Niagara Launcher search deep link -->
        <package android:name="bitpit.launcher" />
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="io.homeassistant.companion.android" />
        <package android:name="com.clicks.companionapp" />
        <!-- Unihertz's settings app: the Titan 2 Elite's Keyboard gesture page -->
        <package android:name="com.agui.settings" />
        <!-- Shizuku: granting it what it needs to start at boot, then opening it -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- Termux tasks in the quick launcher: run a script in ~/.shortcuts through Termux -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Call a contact in the quick launcher: calls straight away when allowed, else opens the dialer -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".PastieraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pastiera">
        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:label="${appLabel}"
            android:theme="@style/Theme.Pastiera" />
        
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.Pastiera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SoftwareKeyboardModeActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:label="@string/software_keyboard_mode_toggle_shortcut_short"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="it.palsoftware.pastiera.action.TOGGLE_SOFTWARE_KEYBOARD_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <!-- SYM customisation -->
        <activity
            android:name=".SymCustomizationActivity"
            android:exported="false"
            android:label="@string/sym_customize_title"
            android:theme="@style/Theme.Pastiera" />
        
        <activity android:name=".KeyboardLayoutActivity" android:exported="false" android:theme="@style/Theme.Pastiera" />
        <activity android:name=".UserShortcutsActivity" android:exported="false" android:theme="@style/Theme.Pastiera" />

        <activity android:name=".CornerCalibrationActivity" android:exported="false"
            android:label="@string/corner_calibration_title" android:theme="@style/Theme.Pastiera" />

        <!-- Settings -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Pastiera">
            <!-- Settings links only navigate and highlight; they never change values.
                 Keep the pastiera scheme and pastiera.eu alias after the Plektra rename.
                 Future: if multiple Stable/Nightly or Pastiera/Plektra apps are installed,
                 consider an in-app choice with explicit forwarding to the selected package.
                 Verified overlapping App Links do not guarantee an Android chooser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="pastiera"
                    android:host="setting" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="pkb.rocks"
                    android:pathPrefix="/settings/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="pastiera.eu"
                    android:pathPrefix="/settings/" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".dictionaries.InstalledDictionariesActivity"
            android:exported="false"
            android:label="@string/installed_dictionaries_title"
            android:theme="@style/Theme.Pastiera.InstalledDictionariesAnimation" />

        <activity
            android:name=".layout.OnlineLayoutsActivity"
            android:exported="false"
            android:label="@string/online_layouts_title"
            android:theme="@style/Theme.Pastiera" />

        <!-- Activity for trackpad debug -->
        <activity
            android:name=".TrackpadDebugActivity"
            android:exported="false"
            android:label="@string/trackpad_debug_title"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- The keyboard (input method service) -->
        <service
            android:name=".inputmethod.PhysicalKeyboardInputMethodService"
            android:label="${imeLabel}"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".spellcheck.PastieraSpellCheckerService"
            android:label="@string/spell_checker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>

        <service
            android:name=".inputmethod.ClicksLauncherButtonAccessibilityService"
            android:exported="true"
            android:label="@string/clicks_launcher_interception_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clicks_launcher_button_accessibility_service" />
        </service>

        <!-- Voice input helper -->
        <activity
            android:name=".inputmethod.SpeechRecognitionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.google.android.inputmethod.latin" />
        
        <!-- Asks for the microphone permission -->
        <activity
            android:name=".inputmethod.PermissionRequestActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />
        
        <!-- Assigns launcher shortcuts to keys -->
        <activity
            android:name=".inputmethod.LauncherShortcutAssignmentActivity"
            android:theme="@style/Theme.Pastiera.OverlayDialog"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <activity
            android:name=".inputmethod.AddSubstitutionActivity"
            android:theme="@style/Theme.Pastiera.OverlayDialog"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <!-- The pairing code typed into the built-in shell's notification -->
        <receiver
            android:name=".adb.shell.ShellSetup$PairReceiver"
            android:exported="false" />
        <!-- Termux's answer when the quick launcher asks for Termux:Widget's scripts -->
        <receiver
            android:name=".shortcuts.TermuxScripts$Receiver"
            android:exported="false" />

        <activity
            android:name=".inputmethod.QuickLauncherActivity"
            android:theme="@style/Theme.Pastiera.QuickLauncherOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <!-- Opens the QuickLauncher from other apps: key mappers, side buttons, Tasker, the app
             icon's long-press shortcut (palsoftware/pastiera#292) -->
        <activity-alias
            android:name=".QuickLauncherEntry"
            android:targetActivity=".inputmethod.QuickLauncherActivity"
            android:exported="true"
            android:label="@string/quick_launcher_title">
            <intent-filter>
                <action android:name="it.palsoftware.pastiera.action.QUICK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Shizuku provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
