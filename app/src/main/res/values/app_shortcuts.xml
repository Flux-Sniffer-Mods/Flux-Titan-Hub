    <string name="app_shortcuts_title">App shortcuts</string>
    <string name="app_shortcuts_description">The same key combos in every app</string>
    <string name="app_shortcuts_intro">Press the same combo in every app: Ctrl+F searches, Ctrl+N makes something new, Alt+↓ goes to the next item. Pastiera sends each app its own shortcut for it, or where the app has none, opens the app’s own share or search screen.</string>
