<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and earlier: no automatic backup, so a reinstall starts fresh instead of bringing
   back an old copy of the settings. Settings move with the in-app backup (a ZIP).
   Android 12 and later use data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
