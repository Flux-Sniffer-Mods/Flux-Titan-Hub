<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- No cloud backup: a reinstall starts fresh (the tutorial and recommended settings run
         again) instead of bringing back an old copy of the settings. Settings move with the
         in-app backup (a ZIP), or to a new phone when setting it up (below). -->
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>

    <!-- Moving to a new phone when setting it up: settings, layouts and mappings come along.
         Restored Clicks device values stay stale until a matching GATT serial is validated. -->
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="recent_emojis_prefs.xml"/>
        <include domain="file" path="keyboard_layouts/"/>
        <include domain="file" path="ctrl_key_mappings.json"/>
        <include domain="file" path="variations.json"/>
        <include domain="file" path="user_defaults.json"/>
    </device-transfer>
</data-extraction-rules>
